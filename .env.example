# Kopieer dit bestand naar .env.local en vul je eigen Supabase keys in.
# Haal deze waarden uit Supabase: Project Settings → API.

# Project URL — ziet er uit als https://xxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Anon public key — lange JWT die begint met "eyJhbGc..."
# Veilig om in de frontend te gebruiken (alleen leesrechten via RLS).
VITE_SUPABASE_ANON_KEY=
