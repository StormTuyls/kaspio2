# Kopieer dit bestand naar .env.local en vul je eigen Supabase keys in.
# Haal deze waarden uit Supabase: Project Settings → API keys.

# Project URL, ziet er uit als https://xxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable key, begint met "sb_publishable_..."
# Veilig om in de frontend te exposen (gaat door RLS).
# Heeft voorrang op de oudere VITE_SUPABASE_ANON_KEY indien beide gezet zijn.
VITE_SUPABASE_PUBLISHABLE_KEY=
